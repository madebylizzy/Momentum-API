# PostgreSQL connection strings
# DATABASE_URL: Pooled connection string (e.g., Neon with PgBouncer / -pooler) used by the running application
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/momentum_properties?schema=public"

# DATABASE_URL_UNPOOLED: Direct, unpooled connection string (e.g., Neon direct) required for Prisma CLI migrations
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/momentum_properties?schema=public"

# Shared API key for write operations (POST, PATCH, DELETE) under /api/v1
# Set manually in Vercel and in local .env; never commit real secrets.
# API_WRITE_KEY="your-secret-write-key-here"


